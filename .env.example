# Postgres connection string.
# Local dev (with `docker compose up -d`): postgresql://nalam:nalam@localhost:5432/nalam
# Production (Vercel): a Neon connection string.
DATABASE_URL="postgresql://nalam:nalam@localhost:5432/nalam"

# Secret used to sign the session cookie. Any long random string.
SESSION_SECRET="change-this-to-a-long-random-string"

# NVIDIA NIM API key (https://build.nvidia.com) for AI assistance.
# If unset, the app falls back to offline template-based Tamil drafts.
NIM_API_KEY=""
NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NIM_MODEL="nvidia/nemotron-3.5-bolt-e4b"
